{% extends "_default/layout.login.twig" %}

{% block content %}
	<div class="card card-md">
		<div class="card-body">
			<h2 class="text-center mb-4">Forgot password?</h2>
			<p class="text-secondary text-center mb-4">Enter your email address and we'll send you a link to reset your password.</p>

			{% if errors.email is defined %}
			<div class="alert alert-danger">Please enter your email address.</div>
			{% endif %}

			<form action="/login?action=forgot_password" method="post">
				<div class="mb-3">
					<label for="email" class="form-label">Email address</label>
					<input type="email" class="form-control{% if errors.email is defined %} is-invalid{% endif %}" id="email" name="email" value="{{ env.post.email|default('') }}" autofocus required>
					{% if errors.email is defined %}
					<div class="invalid-feedback">Required field</div>
					{% endif %}
				</div>
				<div class="form-footer">
					<button type="submit" class="btn btn-primary w-100">Send reset link</button>
				</div>
			</form>

			<div class="text-center mt-3">
				<a href="/login" class="link-secondary">&larr; Back to login</a>
			</div>
		</div>
	</div>
{% endblock content %}
