{% import "_default/macro.tabler.twig" as tabler %}
{% extends "_default/layout.base.twig" %}

{% block title %}{{ category.id is empty ? 'New category' : 'Edit category' }} · Tools{% endblock title %}

{% block content %}
	<div class="row g-3">
		<div class="col-12 col-md-2 col-xl-2">
			{% include "finances/_sidebar.twig" %}
		</div>

		<div class="col-12 col-md-10 col-xl-10">
			<div class="d-flex justify-content-between align-items-center mb-3">
				<h1 class="page-heading mb-0">{{ category.id is empty ? 'New category' : 'Edit category' }}</h1>
				<a href="/finances/settings" class="btn btn-outline-secondary">&larr; Back</a>
			</div>

			<div class="card">
				<div class="card-body">
					{% if errors is not empty %}
						{{ tabler.alert('danger', 'Please fix the errors below.') }}
					{% endif %}

					<form action="{{ category.id is empty ? '/finances/settings?action=category_new' : '/finances/settings?action=category_edit&category_id=' ~ category.id }}" method="post">
						<div class="mb-3">
							<label class="form-label" for="name">Name</label>
							<input type="text" class="form-control{% if errors.name is defined %} is-invalid{% endif %}" id="name" name="name" value="{{ category.name }}">
							{% if errors.name is defined %}
								<div class="invalid-feedback">{{ errors.name }}</div>
							{% endif %}
						</div>

						<div class="mb-3">
							<label class="form-label" for="color">Color</label>
							<div class="d-flex align-items-center gap-3">
								<input type="color" class="form-control form-control-color" id="color" name="color" value="{{ color_value }}">
								<div class="form-check mb-0">
									<input class="form-check-input" type="checkbox" id="color_none" name="color_none" value="1"{% if category.color is empty %} checked{% endif %}>
									<label class="form-check-label" for="color_none">No color</label>
								</div>
							</div>
							{% if errors.color is defined %}
								<div class="text-danger small">{{ errors.color }}</div>
							{% endif %}
						</div>

						<button type="submit" name="save" value="1" class="btn btn-primary">Save</button>
					</form>
				</div>
			</div>
		</div>
	</div>
{% endblock content %}
