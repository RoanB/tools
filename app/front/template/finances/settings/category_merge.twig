{% import "_default/macro.tabler.twig" as tabler %}
{% extends "_default/layout.base.twig" %}

{% block title %}Merge category · Tools{% endblock title %}

{% block content %}
	<div class="row g-3">
		<div class="col-12 col-md-2 col-xl-2">
			{% include "finances/_sidebar.twig" %}
		</div>

		<div class="col-12 col-md-10 col-xl-10">
			<div class="d-flex justify-content-between align-items-center mb-3">
				<h1 class="page-heading mb-0">Merge category</h1>
				<a href="/finances/settings" class="btn btn-outline-secondary">
					<i class="ti ti-arrow-left me-1"></i>Back to categories
				</a>
			</div>

			<div class="card">
				<div class="card-body">
					<p>
						Moving everything from {{ tabler.category_badge(category) }}
						into the target category below: all its transactions
						({{ transaction_count }} active, archived ones included) and its
						{{ rule_count }} rule{{ rule_count == 1 ? '' : 's' }}.
						The source category is archived afterwards. This cannot be
						undone with the interface.
					</p>

					<form action="/finances/settings?action=category_merge&category_id={{ category.id }}" method="post" onsubmit="return confirm('Merge this category into the selected target? All its transactions and rules move there and the source category is archived.');">
						<div class="mb-3">
							<label class="form-label" for="target_id">Target category</label>
							<select name="target_id" id="target_id" class="form-select" data-width="100%" required>
								<option value="">— Choose a category —</option>
								{% for target in targets %}
									<option value="{{ target.id }}">{{ target.name }}</option>
								{% endfor %}
							</select>
							<div class="form-text">
								The target keeps its own name and color; the rules of
								the source category keep their position in the rule
								order.
							</div>
						</div>

						<button type="submit" name="merge_save" value="1" class="btn btn-primary">
							<i class="ti ti-arrows-join me-1"></i>Merge
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>
{% endblock content %}
