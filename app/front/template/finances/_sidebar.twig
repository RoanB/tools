{% set current_path = env.module is defined ? env.module.get_module_path() : '' %}
{% set full = compact is not defined or compact == false %}

{% if full %}
	<div class="card">
		<div class="list-group list-group-flush">
			<a href="/finances" class="list-group-item list-group-item-action{% if current_path starts with '/finances/settings' == false and current_path starts with '/finances/transactions' == false and current_path starts with '/finances/stats' == false and current_path starts with '/finances' and (action is not defined or action == '' or action == 'detail' or action == 'preview' or action == 'import') %} active{% endif %}">
				<i class="ti ti-home me-2"></i> Overview
			</a>
			<a href="/finances/stats" class="list-group-item list-group-item-action{% if current_path starts with '/finances/stats' %} active{% endif %}">
				<i class="ti ti-chart-bar me-2"></i> Statistics
			</a>
			<a href="/finances/transactions" class="list-group-item list-group-item-action{% if current_path starts with '/finances/transactions' %} active{% endif %}">
				<i class="ti ti-list-details me-2"></i> Transactions
			</a>
			<a href="/finances?action=handle" class="list-group-item list-group-item-action{% if action is defined and action == 'handle' %} active{% endif %}">
				<i class="ti ti-flag me-2"></i>To Handle
			</a>
			<button type="button" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between{% if current_path starts with '/finances/settings' %} active{% endif %}" data-bs-toggle="collapse" data-bs-target="#finance-settings-menu" aria-expanded="true">
				<span><i class="ti ti-settings me-2"></i> Settings</span>
				<i class="ti ti-chevron-down"></i>
			</button>
			<div class="collapse show" id="finance-settings-menu">
				<div class="list-group list-group-flush">
					<a href="/finances/settings" class="list-group-item list-group-item-action ps-4{% if current_path == '/finances/settings' and (action is not defined or action == '' or action == 'category_new' or action == 'category_edit') %} active{% endif %}">
						<i class="ti ti-tags me-2"></i> Categories
					</a>
					<a href="/finances/settings?action=rules" class="list-group-item list-group-item-action ps-4{% if action is defined and action starts with 'rule' %} active{% endif %}">
						<i class="ti ti-settings me-2"></i> Rules
					</a>
					<a href="/finances/settings?action=bank_accounts" class="list-group-item list-group-item-action ps-4{% if action is defined and action starts with 'bank_account' %} active{% endif %}">
						<i class="ti ti-credit-card me-2"></i> Bank accounts
					</a>
				</div>
			</div>
		</div>
	</div>
{% else %}
	<div class="card">
		<div class="list-group list-group-flush">
			<a href="/finances" class="list-group-item list-group-item-action{% if current_path starts with '/finances/settings' == false and current_path starts with '/finances/transactions' == false and current_path starts with '/finances/stats' == false and current_path starts with '/finances' and (action is not defined or action == '' or action == 'detail' or action == 'preview' or action == 'import') %} active{% endif %}">
				<i class="ti ti-home me-2"></i> Overview
			</a>
			<a href="/finances/stats" class="list-group-item list-group-item-action{% if current_path starts with '/finances/stats' %} active{% endif %}">
				<i class="ti ti-chart-bar me-2"></i> Stats
			</a>
			<a href="/finances/transactions" class="list-group-item list-group-item-action{% if current_path starts with '/finances/transactions' %} active{% endif %}">
				<i class="ti ti-list-details me-2"></i> Transactions
			</a>
			<a href="/finances?action=handle" class="list-group-item list-group-item-action{% if action is defined and action == 'handle' %} active{% endif %}">
				<i class="ti ti-flag me-2"></i> To Handle
			</a>
			<a href="/finances/settings" class="list-group-item list-group-item-action{% if current_path == '/finances/settings' %} active{% endif %}">
				<i class="ti ti-settings me-2"></i> Settings
			</a>
		</div>
	</div>
{% endif %}
