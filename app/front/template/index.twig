{% extends "_default/layout.base.twig" %}

{% block content %}
<div class="page-header d-print-none mb-4">
	<h1 class="page-heading">Welcome, {{ user.firstname }}</h1>
</div>

<div class="row row-deck row-cards">
	<div class="col-md-6">
		<div class="card card-accent">
			<div class="card-body">
				<h3 class="card-title">Getting started</h3>
				<p>This is a Skeleton-based application using Tabler for the UI.</p>
				<p>Edit <code>app/front/module/Index.php</code> and <code>app/front/template/index.twig</code> to get started.</p>
			</div>
		</div>
	</div>

	<div class="col-md-6">
		<div class="card">
			<div class="card-body">
				<h3 class="card-title">Structure</h3>
				<ul class="list-unstyled mb-0">
					<li><code>app/front/module/</code> — Controllers</li>
					<li><code>app/front/template/</code> — Twig templates</li>
					<li><code>app/front/event/</code> — Event handlers</li>
					<li><code>lib/model/</code> — Models</li>
					<li><code>lib/component/</code> — Components</li>
					<li><code>migration/</code> — Database migrations</li>
				</ul>
			</div>
		</div>
	</div>
</div>
{% endblock content %}
