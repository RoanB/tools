{% extends "_default/layout.base.twig" %}

{% block content %}
<div class="page-header d-print-none mb-4">
	<h1 class="page-heading">Welcome, {{ user.firstname }}</h1>
</div>

<div class="row row-deck row-cards">
	<div class="col-md-6">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">
					<i class="ti ti-credit-card me-2"></i>Finances
				</h3>
				<form action="/" method="get" class="ms-auto">
					<select name="year" class="form-select form-select-sm" style="width: auto" onchange="this.form.submit()">
						{% for drop_year in years %}
							<option value="{{ drop_year }}"{% if drop_year == year %} selected{% endif %}>{{ drop_year }}</option>
						{% endfor %}
					</select>
				</form>
			</div>
			<div class="card-body">
				<div class="d-flex gap-4 mb-3">
					<div class="text-center">
						<div class="h2 mb-0">{{ finance_stats.count }}</div>
						<div class="text-secondary small">Transactions {{ year }}</div>
					</div>
					<div class="text-center">
						<div class="h2 mb-0 text-success">&euro; {{ finance_stats.amount_in|number_format(0, ',', ' ') }}</div>
						<div class="text-secondary small">Incoming {{ year }}</div>
					</div>
					<div class="text-center">
						<div class="h2 mb-0 text-danger">&euro; {{ finance_stats.amount_out|number_format(0, ',', ' ') }}</div>
						<div class="text-secondary small">Outgoing {{ year }}</div>
					</div>
					<div class="text-center">
						<div class="h2 mb-0">{{ finance_stats.uncategorized }}</div>
						<div class="text-secondary small">Uncategorized</div>
					</div>
				</div>

				<div class="text-secondary small mb-2">
					{{ finance_account_count }} bank {{ finance_account_count == 1 ? 'account' : 'accounts' }}
				</div>

				<div class="d-flex gap-2">
					<a href="/finances" class="btn btn-primary">
						<i class="ti ti-arrow-right me-1"></i>Open finances
					</a>
					<a href="/finances/settings" class="btn btn-outline-secondary">Settings</a>
				</div>
			</div>
		</div>
	</div>

	<div class="col-md-6">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">
					<i class="ti ti-anchor me-2"></i>Fallforce
				</h3>
			</div>
			<div class="card-body">
				<p class="text-secondary mb-3">
					Fall force calculator for SRT: peak force, fall factor and
					rope stretch for a given drop, body mass and rope type.
				</p>
				<a href="/fallforce" class="btn btn-primary">
					<i class="ti ti-arrow-right me-1"></i>Open fallforce
				</a>
			</div>
		</div>
	</div>

	<div class="col-md-6">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">
					<i class="ti ti-wand me-2"></i>Prompt builder
				</h3>
			</div>
			<div class="card-body">
				<p class="text-secondary mb-3">
					Assemble a structured prompt for AI website generators
					(v0, Lovable, Bolt, Claude&hellip;) from a guided form with
					dropdowns for style, structure and hosting. Public page;
					signed in you also keep a history of saved prompts.
				</p>
				<a href="/promptbuilder" class="btn btn-primary">
					<i class="ti ti-arrow-right me-1"></i>Open prompt builder
				</a>
			</div>
		</div>
	</div>
</div>
{% endblock content %}
